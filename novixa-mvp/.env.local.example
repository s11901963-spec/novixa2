# Copy to .env.local (never commit .env.local).
# HIOBuy Product API key (1688 / Taobao): https://developers.hiobuy.com
# Without it the site runs on clearly-labelled demo data.
HIOBUY_API_KEY=
# Response language for product titles/descriptions (en by default).
HIOBUY_DEFAULT_LANGUAGE=en
# Optional: override the API host (defaults to https://api.hiobuy.com).
# HIOBUY_API_BASE_URL=

# Optional: OpenAI key used by the legacy /api/analyze route.
OPENAI_API_KEY=
